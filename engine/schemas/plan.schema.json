{
  "type": "object",
  "additionalProperties": false,
  "required": ["goal", "context_sources", "tasks", "final_verify"],
  "properties": {
    "goal": { "type": "string" },
    "context_sources": {
      "type": "array",
      "maxItems": 100,
      "items": { "type": "string" }
    },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "objective", "read_files", "write_paths", "verify", "network"],
        "properties": {
          "id": { "type": "string", "pattern": "^task-[0-9]{2}$" },
          "name": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
          "objective": { "type": "string" },
          "read_files": {
            "type": "array",
            "maxItems": 100,
            "items": { "type": "string" }
          },
          "write_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": { "type": "string" }
          },
          "verify": {
            "type": "array",
            "minItems": 1,
            "maxItems": 30,
            "items": {
              "type": "array",
              "minItems": 1,
              "maxItems": 100,
              "items": { "type": "string" }
            }
          },
          "network": { "type": "boolean" }
        }
      }
    },
    "final_verify": {
      "type": "array",
      "minItems": 1,
      "maxItems": 30,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 100,
        "items": { "type": "string" }
      }
    }
  }
}
